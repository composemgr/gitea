# Gitea environment configuration
# Copy to app.env and customize before starting

# Timezone
TZ=America/New_York

# Hostname
BASE_HOST_NAME=gitea.example.com

# Application name
APP_NAME=Gitea

# Security keys (min 32 chars each)
APP_SECRET_KEY=changeme_secret_key_min_32_chars
APP_INTERNAL_TOKEN=changeme_internal_token_min_32_chars

# Database (PostgreSQL)
DB_CREATE_DATABASE_NAME=gitea
DB_USER_NAME=gitea
DB_USER_PASS=changeme_db_password

# Email / SMTP
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=
EMAIL_SERVER_MAIL_FROM=noreply@example.com
